{
  "expo": {
    "name": "Boathouse Connect",
    "slug": "Boathouse Connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bfa49246-3d8e-496b-a08e-21e3a86c5e00.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/bfa49246-3d8e-496b-a08e-21e3a86c5e00.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mcloones.boathouse",
      "icon": "./assets/images/bfa49246-3d8e-496b-a08e-21e3a86c5e00.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/bfa49246-3d8e-496b-a08e-21e3a86c5e00.png",
        "backgroundColor": "#FFFFFF"
      },
      "icon": "./assets/images/bfa49246-3d8e-496b-a08e-21e3a86c5e00.png",
      "edgeToEdgeEnabled": true,
      "package": "com.mcloonesboathouseapp.boathouseapp"
    },
    "web": {
      "favicon": "./assets/images/bfa49246-3d8e-496b-a08e-21e3a86c5e00.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/bfa49246-3d8e-496b-a08e-21e3a86c5e00.png",
          "color": "#3289a8",
          "defaultChannel": "messages"
        }
      ]
    ],
    "scheme": "mcloones",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  },
  "scheme": "Boathouse Connect"
}